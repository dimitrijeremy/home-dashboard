# Salin file ini ke .env lalu isi nilainya.
# File .env TIDAK ikut git (lihat .gitignore) — jangan commit kredensial.
#
# Semua nilai NVR di bawah hanya SEED AWAL: dipakai sekali saat database masih
# kosong. Setelah aplikasi jalan, ubah host/kredensial dari menu
# Konfigurasi > Kredensial NVR di dashboard (tersimpan di database).

# ── NVR (Dahua) ──────────────────────────────────────────────────────────────
DVR_HOST=10.10.30.2
DVR_HTTP_PORT=80
DVR_USER=
# Karakter $ dalam password harus ditulis ganda ($$) —
# docker compose menginterpolasi $VAR di file .env.
DVR_PASS=

# Akun terpisah untuk event stream (butuh hak operator/admin Dahua).
# Kosongkan untuk fallback ke DVR_USER/DVR_PASS.
DVR_EVENT_USER=
DVR_EVENT_PASS=

# Jumlah channel built-in NVR yang ditampilkan di dashboard
NVR_CHANNELS=4

# ── Analyzer (profil 'ai') ───────────────────────────────────────────────────
# Proses 1 dari N frame (semakin besar semakin ringan)
PROCESS_EVERY=8
FACE_THRESH=0.40
ZONE_CONF=0.40
COOLDOWN_SECS=20
# Face recognition maksimal 1x per N detik per channel
FACE_EVERY_SECS=2.0
# Ukuran inferensi YOLO (640 default; 480/416 lebih hemat CPU)
YOLO_IMGSZ=640

# ── Hardware encode (opsional, lihat DEPLOY.md § 7b) ─────────────────────────
# Kosong = software encode (default, aman di semua server). Isi "vaapi" hanya
# setelah /dev/dri diverifikasi ada di server DAN devices: di-uncomment di
# docker-compose.yml untuk service mtx + backend.
HWACCEL=
VAAPI_DEVICE=/dev/dri/renderD128

# ── Login Dashboard ───────────────────────────────────────────────────────────
# Seed user pertama — HANYA dipakai sekali saat tabel users masih kosong.
# GANTI password ini lewat menu Konfigurasi > Users segera setelah login pertama.
ADMIN_USER=admin
ADMIN_PASS=admin123
# Sesi browser idle lebih dari ini (menit) wajib login ulang.
SESSION_TIMEOUT_MINUTES=10
# Set "true" hanya kalau dashboard diakses lewat HTTPS (:8443, lihat
# MONITORING.md § 4) — HTTP polos (default LAN) wajib biarkan ini kosong.
COOKIE_SECURE=

# Whitelist segmen yang boleh login (seed awal; setelah itu via UI tab Users).
ALLOWED_LOGIN_CIDRS=10.10.100.0/24,10.10.80.0/24,127.0.0.1/32
# Pintu darurat anti-lockout — selalu di-union dengan whitelist di atas.
# ISI DENGAN SEGMEN PC KAMU kalau tidak termasuk whitelist di atas!
EXTRA_LOGIN_CIDRS=

# ── Monitoring (lihat MONITORING.md) ─────────────────────────────────────────
# Interval scan keamanan NVR (deteksi akun baru + log login NVR), detik
NVR_SECURITY_SCAN_SECS=300
# Postgres monitoring — diakses DBeaver dari LAN port 5432. GANTI password!
PG_DB=monitoring
PG_USER=monitor
PG_PASS=monitor@DLT1601.

# ── Housekeeping storage (volume camera_data) ────────────────────────────────
# Tiap event "Start" dari NVR menulis 1 snapshot JPEG + 1 clip MP4 bitrate
# penuh. Tanpa batas, volume camera_data tumbuh terus (~2 GB/hari pada 4
# channel). Janitor di backend jalan tiap MEDIA_JANITOR_SECS detik dan
# membuang file event TERTUA duluan sampai total kembali di bawah budget.
#
# PERINGATAN: menurunkan MEDIA_MAX_GB langsung menghapus file lama secara
# permanen pada siklus janitor berikutnya. Backup dulu kalau ada clip penting.
#
# Budget keras direktori media event, GB. 0 = tanpa batas (perilaku lama).
MEDIA_MAX_GB=40
# Umur maksimal file event, hari. 0 = tanpa batas umur (hanya budget di atas).
MEDIA_RETENTION_DAYS=30
# Interval siklus janitor, detik.
MEDIA_JANITOR_SECS=600
# Batas jumlah baris tabel nvr_events / detection_events supaya cameras.db
# tidak ikut membengkak. 0 = tanpa batas.
EVENT_DB_MAX_ROWS=50000
# Rem di sisi PRODUKSI (bukan penghapusan): VideoMotion/SmartMotionHuman
# dikirim NVR berulang selama masih ada gerakan. Isi detik untuk membatasi
# 1 snapshot+clip per channel per N detik untuk kode itu — event tetap masuk
# log, hanya medianya yang dilewat. 0 = capture semua (perilaku lama).
NVR_EVENT_NOISY_COOLDOWN_SECS=60
# Durasi clip event, detik. Ini pengali langsung ukuran per clip.
NVR_EVENT_CLIP_SECS=12
